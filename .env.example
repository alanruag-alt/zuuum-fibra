# ============================================================================
# ZUUUM FIBRA · variables de entorno
# ----------------------------------------------------------------------------
# Copia este archivo como .env.local y llena los valores.
# .env.local NUNCA se sube al repositorio (ya está en .gitignore).
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Se sacan de: panel de Supabase -> Settings -> API

# URL del proyecto. NO es secreta: viaja al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave pública (anon). NO es secreta: viaja al navegador.
# La seguridad real la dan las políticas RLS de la base, no esconder esta llave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_llave_anon_aqui

# Llave de servicio. ¡SECRETA! Se salta todas las políticas RLS.
# Solo se usa en el servidor. Jamás con prefijo NEXT_PUBLIC_.
# Si esta llave se filtra, hay que rotarla de inmediato en Supabase.
SUPABASE_SERVICE_ROLE_KEY=tu_llave_service_role_aqui

# --- Aplicación -------------------------------------------------------------
NEXT_PUBLIC_URL_SITIO=http://localhost:3000
NEXT_PUBLIC_NOMBRE_APP=ZUUUM FIBRA

# --- Agente local (etapa 12, todavía no se usa) -----------------------------
# El agente vive dentro de la red de ZUUUM y SALE hacia la plataforma.
# Las contraseñas de OLT, MikroTik y UISP viven SOLO en el agente,
# nunca en este proyecto ni en la base de datos.
# AGENTE_CLAVE_COMPARTIDA=
