{
  "name": "zuuum-fibra",
  "version": "0.1.0",
  "private": true,
  "description": "Panel administrativo de ZUUUM FIBRA · ISP mixto FTTH + WISP",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "formato": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "formato:revisar": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "tipos": "tsc --noEmit",
    "prueba": "npm run tipos && npm run lint && npm run formato:revisar",
    "verificar": "npm run prueba && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.48.1",
    "html-to-image": "^1.11.13",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.1.6",
    "eslint-config-prettier": "9.1.0",
    "postcss": "8.5.1",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
